# Base de datos PostgreSQL (usuario y password son los mismos que en docker-compose.yml)
DATABASE_URL=postgresql://user:password@localhost:5432/ragdb

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modelos Ollama (nomic-embed-text -> 768 dims)
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50